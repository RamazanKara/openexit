      "writesExternalState": false,
      "humanApprovalRequired": false
    },
    {
      "id": "ticket-update",
      "usageClassId": "support-chat",
      "name": "Ticket update",
      "type": "http-write",
      "networkAccess": true,
      "writesExternalState": true,
      "humanApprovalRequired": false
    },
    {
      "id": "repo-search",
      "usageClassId": "code-assist",
      "name": "Repository search",
      "type": "vector-search",
      "networkAccess": false,
      "writesExternalState": false,
      "humanApprovalRequired": false
    }
  ],
  "fallbackBehaviors": [
    {
      "id": "support-chat-fallback",
      "usageClassId": "support-chat",
      "strategy": "manual-queue",
      "models": [],
      "manualQueue": true,
      "maxRetries": 1
    },
    {
      "id": "code-assist-fallback",
      "usageClassId": "code-assist",
      "strategy": "retry-source-provider",
      "models": ["claude-3-5-sonnet"],
      "manualQueue": false,
      "maxRetries": 3
    },
    {
      "id": "batch-summarization-fallback",
      "usageClassId": "batch-summarization",
      "strategy": "defer-batch",
      "models": [],
      "manualQueue": false,
      "maxRetries": 2
    }
  ]
