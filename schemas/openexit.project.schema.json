{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openexit.dev/schemas/openexit.project.schema.json",
  "title": "OpenExit Project",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "source", "target", "policy"],
  "properties": {
    "apiVersion": { "const": "openexit.dev/v1alpha1" },
    "kind": { "const": "Project" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["datadog", "github-enterprise", "identity", "edge", "ai-provider"]
        },
        "site": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["grafana-lgtm", "forgejo", "keycloak-zitadel", "varnish-haproxy-coraza", "vllm-litellm"]
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["allowNetworkWrites", "allowProductionWrites", "allowAI"],
      "properties": {
        "allowNetworkWrites": { "type": "boolean" },
        "allowProductionWrites": { "type": "boolean" },
        "allowAI": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "source": { "properties": { "type": { "const": "datadog" } } },
        "target": { "properties": { "type": { "const": "grafana-lgtm" } } }
      }
    },
    {
      "properties": {
        "source": { "properties": { "type": { "const": "github-enterprise" } } },
        "target": { "properties": { "type": { "const": "forgejo" } } }
      }
    },
    {
      "properties": {
        "source": { "properties": { "type": { "const": "identity" } } },
        "target": { "properties": { "type": { "const": "keycloak-zitadel" } } }
      }
    },
    {
      "properties": {
        "source": { "properties": { "type": { "const": "edge" } } },
        "target": { "properties": { "type": { "const": "varnish-haproxy-coraza" } } }
      }
    },
    {
      "properties": {
        "source": { "properties": { "type": { "const": "ai-provider" } } },
        "target": { "properties": { "type": { "const": "vllm-litellm" } } }
      }
    }
  ]
}
