{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openexit.dev/schemas/openexit.inventory.schema.json",
  "title": "OpenExit Inventory",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "source", "assets", "summary"],
  "properties": {
    "apiVersion": { "const": "openexit.dev/v1alpha1" },
    "kind": { "const": "Inventory" },
    "metadata": {
      "type": "object",
      "required": ["project", "source", "collectedAt", "collectorVersion"]
    },
    "source": {
      "type": "object",
      "required": ["type"]
    },
    "assets": {
      "type": "object",
      "properties": {
        "repositories": { "type": "array" },
        "teams": { "type": "array" },
        "branchProtections": { "type": "array" },
        "actionsWorkflows": { "type": "array" },
        "secrets": { "type": "array" },
        "runners": { "type": "array" },
        "deployKeys": { "type": "array" },
        "githubApps": { "type": "array" },
        "identityApplications": { "type": "array" },
        "identityGroups": { "type": "array" },
        "identityPolicies": { "type": "array" },
        "mfaSettings": { "type": "array" },
        "breakGlassAccounts": { "type": "array" },
        "dnsRecords": { "type": "array" },
        "wafRules": { "type": "array" },
        "cacheRules": { "type": "array" },
        "redirects": { "type": "array" },
        "origins": { "type": "array" },
        "tlsSettings": { "type": "array" },
        "botRules": { "type": "array" },
        "pageRules": { "type": "array" }
      }
    },
    "summary": { "type": "object" },
    "volumes": {
      "type": "object",
      "properties": {
        "logVolumeKnown": { "type": "boolean" },
        "traceVolumeKnown": { "type": "boolean" }
      }
    }
  }
}
