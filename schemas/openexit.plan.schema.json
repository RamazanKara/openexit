{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openexit.dev/schemas/openexit.plan.schema.json",
  "title": "OpenExit Migration Plan",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "source", "target", "summary", "phases"],
  "properties": {
    "apiVersion": { "const": "openexit.dev/v1alpha1" },
    "kind": { "const": "MigrationPlan" },
    "metadata": {
      "type": "object",
      "required": ["project", "generatedAt"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "type": "string" } }
    },
    "target": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "type": "string" } }
    },
    "summary": {
      "type": "object",
      "required": ["status", "requiredArtifacts", "missingArtifacts"],
      "properties": {
        "status": { "enum": ["ready", "incomplete"] },
        "requiredArtifacts": { "type": "integer", "minimum": 0 },
        "missingArtifacts": { "type": "integer", "minimum": 0 }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "objective", "status", "requiredArtifacts", "exitCriteria"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ready", "incomplete"] },
          "requiredArtifacts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "missingArtifacts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "exitCriteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
