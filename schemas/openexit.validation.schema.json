{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openexit.dev/schemas/openexit.validation.schema.json",
  "title": "OpenExit Validation Report",
  "type": "object",
  "required": ["apiVersion", "kind", "status", "checks"],
  "properties": {
    "apiVersion": { "const": "openexit.dev/v1alpha1" },
    "kind": { "const": "ValidationReport" },
    "status": { "enum": ["passed", "failed"] },
    "checks": { "type": "array" }
  }
}
